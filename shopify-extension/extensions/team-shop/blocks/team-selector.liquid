<lincforge-team-shop class="lf-shop" data-currency="{{ cart.currency.iso_code | escape }}" {{ block.shopify_attributes }}>
  <h2>{{ block.settings.heading | escape }}</h2>
  {% if block.settings.products.size > 0 %}
  <label>Choose your team
    <select data-team>
      {% for item in block.settings.products %}
        <option value="{{ item.id }}" data-product="{{ item | json | escape }}" data-team-name="{{ item.metafields.custom.team_name.value | default: item.title | escape }}" data-theme="{{ item.metafields.custom.jersey_theme.value | default: 'Light' | escape }}" data-logo="{{ item.metafields.custom.front_logo.value | default: 'Team crest' | escape }}">{{ item.metafields.custom.team_name.value | default: item.title | escape }}</option>
      {% endfor %}
    </select>
  </label>
  <label>Jersey theme<select data-theme></select></label>
  <label>Front logo<select data-logo></select></label>
  <div class="lf-product">
    <div><img data-image alt="" width="700" height="700" loading="lazy"><div data-images class="lf-thumbs"></div></div>
    <div><h3 data-title></h3><p data-price></p><label>Size / options<select data-variant></select></label>
      <button data-add type="button" disabled>Add to cart</button>
      <p data-status role="status" aria-live="polite"></p>
      <a data-link>View full product details</a>
    </div>
  </div>
  {% else %}
    <p>Select your published team products in this block's settings.</p>
  {% endif %}
</lincforge-team-shop>
{% schema %}
{
 "name":"ForgeLinc team shop","target":"section","stylesheet":"team-shop.css","javascript":"team-shop.js",
 "settings":[
 {"type":"text","id":"heading","label":"Heading","default":"Your team. Your gear."},
 {"type":"product_list","id":"products","label":"Team products","limit":50}
 ]
}
{% endschema %}

